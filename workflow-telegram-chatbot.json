              "id": "9e07e1e4-e905-4289-a98e-8de238f8ad21",
              "name": "queue",
              "value": "=\n{{ \n  (() => {\n    const partes = ($json.message?.text ?? '')\n      .trim()\n      .split(',')\n      .map(p => p.trim())\n      .filter(Boolean);\n\n    const cidade = partes[0]\n      .normalize('NFD')\n      .replace(/[\\u0300-\\u036f]/g, '')\n      .toLowerCase();\n\n    let pais = partes.length >= 3\n      ? partes[2]\n      : partes.length === 2 && partes[1].length !== 2\n        ? partes[1]\n        : 'br';\n\n    pais = pais\n      .normalize('NFD')\n      .replace(/[\\u0300-\\u036f]/g, '')\n      .toLowerCase();\n\n    return `${cidade},${pais}`;\n  })()\n}}\n",
              "type": "string"
            },
            {
              "id": "c755e5c5-eb6e-4b5a-8b01-5c19123ace91",
              "name": "cidadeOriginal",
              "value": "={{ $json.message.text }}",
