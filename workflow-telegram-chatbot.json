    {
      "parameters": {
        "chatId": "={{ $('Edit Fields1').item.json.chatId }}",
        "text": "={{ \n  (() => {\n    const clima = $json.weather[0];\n    const temperatura = Math.ceil($json.main.temp);\n    const cidade = $json.name;\n    const codigo = clima.icon;\n\n    let emoji = '🌡️';\n\n    if (codigo.startsWith('01')) {\n      emoji = codigo.endsWith('d') ? '☀️' : '🌙';\n    } else if (codigo.startsWith('02')) {\n      emoji = '🌤️';\n    } else if (codigo.startsWith('03')) {\n      emoji = '☁️';\n    } else if (codigo.startsWith('04')) {\n      emoji = '☁️';\n    } else if (codigo.startsWith('09') || codigo.startsWith('10')) {\n      emoji = '🌧️';\n    } else if (codigo.startsWith('11')) {\n      emoji = '⛈️';\n    } else if (codigo.startsWith('13')) {\n      emoji = '❄️';\n    } else if (codigo.startsWith('50')) {\n      emoji = '🌫️';\n    }\n\n    return `${emoji} A temperatura em ${cidade} é de ${temperatura}°C.`;\n  })()\n}}",
        "additionalFields": {}
